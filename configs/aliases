alias aiexec="aichat -e"

# Allows to keep aliases in sudo
alias sudo="sudo "

alias pacman="pacman --color auto"
alias pacboy="pacman --config $PEARL_PKGDIR/configs/omarchy/pacman.conf"

alias ..="cd .."
alias ...="cd ../.."
alias "c.."="cd .."
alias "c-"="cd -"
alias "c~"="cd $HOME"
alias "cd-"="cd -"

# Mini-aliases :)
alias j="jobs"
alias f="fg"
alias b="bg"
alias q="exit"
alias l="ls --color=auto -h"
alias a="ls -ha"
alias d="date"
alias p='pwd'
alias h='hostname'
alias t='tree'
alias t1='t -L 1'
alias t2='t -L 2'
alias t2='t -L 3'
alias ll="l -l"
alias la="a -l"